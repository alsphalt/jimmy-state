# ---------------------------------------------------------------------------
# JIMMY STATE — server configuration
# Copy to .env and fill in. Never expose these values to the browser.
# ---------------------------------------------------------------------------

# Server
PORT=3001
NODE_ENV=development

# Music recognition (ACRCloud)
# Console: https://console.acrcloud.com  -> Projects -> your project
# Copy the "host", "access key" and "access secret" from the project page.
# Free trial: 100 identifications/month, ~10s of audio per request.
# PostgreSQL (Neon) — server-side only. Never prefix with VITE_, which would bundle it
# into the browser build. On Vercel use the pooled string (host contains "-pooler").
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Optional: set to 1 only if the runtime does not trust Neon's certificate chain.
PG_SSL_NO_VERIFY=

ACR_HOST=identify-ap-southeast-1.acrcloud.com
ACR_ACCESS_KEY=your_acrcloud_access_key
ACR_ACCESS_SECRET=your_acrcloud_access_secret

# External metadata (platform links, hi-res covers, composer credits).
# This is NOT the identify key/secret. Create a token in the ACRCloud console:
# console.acrcloud.com -> account -> developer -> create token.
# Leave empty to disable: recognition still works, buttons simply do not appear.
ACR_METADATA_TOKEN=
ACR_METADATA_PLATFORMS=applemusic,spotify,deezer,youtube

# YouTube Data API v3 (search only — playback uses the public IFrame Player API)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Default quota: 10,000 units/day. A search costs 100 units, videos.list costs 1.
# Leaving this empty keeps the Videos tab in "setup" mode; nothing is faked.
YOUTUBE_API_KEY=
# Only if the key is restricted to "HTTP referrers": the origin it is restricted to.
# Server-side calls send no Referer, so Google answers 403 until either this is set
# or the key's application restriction is changed to None / IP addresses.
YOUTUBE_REFERER=

# --- Deployment topology ---------------------------------------------------
# Only needed when the frontend and the API are hosted separately.
# Vite reads this at BUILD time; the production bundle then calls that origin.
# VITE_API_BASE=https://api.example.com
#
# Origins allowed to call this API cross-origin (comma separated, exact match).
# CORS_ORIGINS=https://jimmystate.example.com
#
# The Android app is exempt: Capacitor serves the same bundle from https://localhost,
# which the server always allows. A new APK therefore works against this deployment
# without any CORS_ORIGINS change.

# --- Full-length music ------------------------------------------------------
# Epidemic Sound partner API — the licensed source for complete tracks.
# Key: https://developers.epidemicsound.com/portal  (Get free API key)
# Free plan: full catalogue, 50 downloads, prototyping only — you cannot go live
# on it. Production needs a Scale/Enterprise agreement with sub-licensing.
# Playback uses the provider's HLS stream; downloads use its MP3 endpoint and
# each one is metered. Leave empty to keep the full-track features hidden.
EPIDEMIC_API_KEY=

# Free To Use (https://api.freetouse.com/v3) is a public API with no key, but its
# free licence permits User-Generated Content only and expressly forbids use in a
# "Digital Product" (web/mobile apps, SaaS). Streaming its library from this app
# therefore requires a paid Commercial licence. This build does not use it.
# Set to "commercial" only after buying that licence, then wire the provider in.
FREETOUSE_LICENCE=unset

# Catalogue region for artwork / previews / charts (ISO 3166-1 alpha-2)
CATALOG_COUNTRY=US

# Download sources — extra hosts you are contractually allowed to save from.
# Comma separated. Apple preview hosts are always allowed.
DOWNLOAD_ALLOWED_HOSTS=
MAX_DOWNLOAD_BYTES=62914560
