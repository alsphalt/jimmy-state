# ---------------------------------------------------------------------------
# JIMMY STATE — server configuration
# Copy to .env and fill in. Never expose these values to the browser.
# ---------------------------------------------------------------------------

# Server
PORT=3001
NODE_ENV=development

# Music recognition (ACRCloud)
# Console: https://console.acrcloud.com  -> Projects -> your project
# Copy the "host", "access key" and "access secret" from the project page.
# Free trial: 100 identifications/month, ~10s of audio per request.
ACR_HOST=identify-ap-southeast-1.acrcloud.com
ACR_ACCESS_KEY=your_acrcloud_access_key
ACR_ACCESS_SECRET=your_acrcloud_access_secret

# External metadata (platform links, hi-res covers, composer credits).
# This is NOT the identify key/secret. Create a token in the ACRCloud console:
# console.acrcloud.com -> account -> developer -> create token.
# Leave empty to disable: recognition still works, buttons simply do not appear.
ACR_METADATA_TOKEN=
ACR_METADATA_PLATFORMS=applemusic,spotify,deezer,youtube

# YouTube Data API v3 (search only — playback uses the public IFrame Player API)
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Default quota: 10,000 units/day. A search costs 100 units, videos.list costs 1.
# Leaving this empty keeps the Videos tab in "setup" mode; nothing is faked.
YOUTUBE_API_KEY=

# Catalogue region for artwork / previews / charts (ISO 3166-1 alpha-2)
CATALOG_COUNTRY=US

# Download sources — extra hosts you are contractually allowed to save from.
# Comma separated. Apple preview hosts are always allowed.
DOWNLOAD_ALLOWED_HOSTS=
MAX_DOWNLOAD_BYTES=62914560
