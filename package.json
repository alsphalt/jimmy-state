{
  "name": "jimmy-state",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "JIMMY STATE \u2014 music recognition, discovery, video streaming and authorized downloads.",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node server/index.js\" \"vite\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "node scripts/build-version.mjs && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "test": "node scripts/make-api-routes.mjs --check && node tests/ssr-smoke.mjs && node tests/android.mjs && node tests/run.mjs && node tests/db.mjs && node tests/download-client.mjs && node tests/vercel-routing.mjs",
    "test:api": "node tests/run.mjs",
    "test:downloads": "node tests/download-client.mjs",
    "api:routes": "node scripts/make-api-routes.mjs",
    "test:db": "node tests/db.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "version:app": "node scripts/build-version.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "test:android": "node tests/android.mjs",
    "test:ui": "node tests/ssr-smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/share": "7.0.4",
    "@capacitor/splash-screen": "7.0.2",
    "@capacitor/status-bar": "7.0.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "i18next": "^23.16.8",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/cli": "7.6.10",
    "@electric-sql/pglite": "^0.5.14",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
