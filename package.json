{
  "name": "jimmy-state",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "JIMMY STATE — music recognition, discovery, video streaming and authorized downloads.",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"node server/index.js\" \"vite\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "test": "node scripts/make-api-routes.mjs --check && node tests/run.mjs && node tests/db.mjs && node tests/download-client.mjs && node tests/vercel-routing.mjs",
    "test:api": "node tests/run.mjs",
    "test:downloads": "node tests/download-client.mjs",
    "api:routes": "node scripts/make-api-routes.mjs",
    "test:db": "node tests/db.mjs",
    "db:migrate": "node scripts/db-migrate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.8"
  }
}
